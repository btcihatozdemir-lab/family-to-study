# ==============================================================================
# FAMILY-TO-STUDY - ÇEVRE DEĞİŞKENLERİ ŞABLONU (.env.example)
# ==============================================================================
# Bu dosyayı '.env.local' (Next.js PWA) veya 'windows-agent/.env' (Windows Ajanı)
# olarak kopyalayıp ilgili değerleri kendi Supabase projenize göre doldurun.
# DİKKAT: Gerçek anahtarları asla Git deposuna (commit) eklemeyin!
# ==============================================================================

# 1. Supabase Genel Bağlantı Bilgileri (İstemci & PWA & Windows Ajanı için güvenli)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here

# 2. Supabase Yönetici ve Veritabanı Bilgileri (YALNIZCA yerel test & migration betikleri için)
# DİKKAT: İstemci tarafında ve Windows Ajanında ASLA Secret / Service Role Key kullanılmaz!
SUPABASE_SECRET_KEY=your_supabase_secret_service_role_key_here
SUPABASE_DB_PASSWORD=your_supabase_postgres_password_here

# 3. Ebeveyn Güvenlik PIN'i (Varsayılan Acil Durum PIN Kodu)
NEXT_PUBLIC_PARENT_PIN=1234

# 4. Windows Desktop Ajanı Özel Yapılandırmaları (windows-agent/.env için isteğe bağlı)
FAMILY_ID=fam-ozdemir
STUDENT_USER_ID=child-omer
DEVICE_ID=dev-omer-pc
DEVICE_NAME=Ömer Bilgisayarı
PARENT_RECEIVER_ID=parent-mom

# 5. PWA ve Sunucu Adresleri
# Yerel testler için: http://localhost:3000
# Canlı GitHub Pages için: https://kullaniciadi.github.io/family-to-study
FAMILY_PWA_URL=http://localhost:3000
PWA_PRODUCTION_URL=https://your-username.github.io/family-to-study
